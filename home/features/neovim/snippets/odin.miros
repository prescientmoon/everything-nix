import common/unicode-subperscripts
import common/unicode-misc

string loc
  name loc parameter
  desc Automatically passed location parameter
  snip loc := #caller_location

block auto
  abbr anyint #any_int
  -- block !word
  -- abbr __ ›

block start
  abbr private \@(private)
  abbr fprivate \@(private="file")
  abbr reqres \@(require_results)

  string const
    snip $1 :: $0

  string proc
    snip
      $1 :: proc ($2) $?3⟨-> ⟩$|3⟨$3,($3\, ok: bool)⟩ {
        $4
      }
      $0

  for kind <- @⟨struct,enum,bit_field⟩
  string @⟨@kind:struct,enum,bitfield⟩
    snip
      $1 :: @kind $2 {
        $3
      }
      $0

for kind <- @⟨when,if,else if⟩
string @⟨@kind:when,if,elif⟩
  snip
    @kind $1 {
      $2
    } $0

string forin
  snip
    for $1 in $2 {
      $3
    } $0

string foriter
  name for iter loop
  snip
    for iter := iter__mk($1); $2 in iter__next(&iter) {
      $0
    }

string foriterdo
  name for iter do loop
  snip
    iter := iter__mk($1)
    for $2 in iter__next(&iter) do $0

for level <- @⟨debug,info,warn,error,assert⟩

abbr f@level log.@level⋄f("$1", $2)$0
abbr @level  log.@level($1)$0
