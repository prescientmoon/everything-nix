;; {{{ Source layout
(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet $RED                    spc             $BLUE
)
;; }}}
;; {{{ Transparent layer template
;; (deflayer template
;;   _    _    _    _    _    _    _    _    _    _    _    _    _    _
;;   _    _    _    _    _    _    _    _    _    _    _    _    _    _
;;   _    _    _    _    _    _    _    _    _    _    _    _    _
;;   _    _    _    _    _    _    _    _    _    _    _    _
;;   _    _    _              _              _
;; )
;; }}}

(defchordsv2-experimental
  ;; {{{ Wm keybinds
  (n l k) M-p $CHORD_DELAY all-released () ;; Launch app picker

  ;; These are unreliable on laptop keyboards (because fuck laptop keyboards
  ;; ignoring chords of 4+ characters :[ )
  (n l r d f) M-j   $CHORD_DELAY all-released () ;; Focus prev app
  (n l   d f) M-k   $CHORD_DELAY all-released () ;; Focus next app
  (n l r e f) M-S-h $CHORD_DELAY all-released () ;; Focus prev tab
  (n l   e f) M-S-l $CHORD_DELAY all-released () ;; Focus next tab

  (n l q) M-1 $CHORD_DELAY all-released ()
  (n l w) M-2 $CHORD_DELAY all-released ()
  (n l e) M-3 $CHORD_DELAY all-released ()
  (n l r) M-4 $CHORD_DELAY all-released ()
  (n l t) M-5 $CHORD_DELAY all-released ()
  (n l a) M-6 $CHORD_DELAY all-released ()
  (n l s) M-7 $CHORD_DELAY all-released ()
  (n l d) M-8 $CHORD_DELAY all-released ()
  (n l f) M-9 $CHORD_DELAY all-released ()
  (n l g) M-0 $CHORD_DELAY all-released ()
  ;; }}}
  ;; {{{ Left modifiers
  (a s d f) (multi lctl lalt lsft) $CHORD_DELAY all-released ()
  (a s d  ) (multi lalt lsft) $CHORD_DELAY all-released ()
  (  s d f) (multi lctl lsft) $CHORD_DELAY all-released ()
  (a s    ) lalt $CHORD_DELAY all-released ()
  (  s d  ) lsft $CHORD_DELAY all-released ()
  (  s   f) lctl $CHORD_DELAY all-released ()
  ;; }}}
  ;; {{{ Right modifiers
  (j k l ;) (multi rctl ralt rsft) $CHORD_DELAY all-released ()
  (j k l  ) (multi rctl rsft) $CHORD_DELAY all-released ()
  (  k l ;) (multi ralt rsft) $CHORD_DELAY all-released ()
  (j   l  ) rctl $CHORD_DELAY all-released ()
  (  k l  ) rsft $CHORD_DELAY all-released ()
  (    l ;) ralt $CHORD_DELAY all-released ()
  ;; }}}
  ;; {{{ Special keys
  (d f) tab  $CHORD_DELAY all-released ()
  (e f) ret  $CHORD_DELAY all-released ()
  (q w) esc  $CHORD_DELAY all-released ()

  (g h) bspc $CHORD_DELAY all-released ()
  (n l) rmet $CHORD_DELAY all-released ()

  (j k) f10  $CHORD_DELAY all-released ()
  (c p) f11  $CHORD_DELAY all-released ()
  (j i) f12  $CHORD_DELAY all-released ()
  ;; }}}
  ;; {{{ Extra layers
  (u i  o)             @upper-greek $CHORD_DELAY all-released ()
  (w e  r)             @upper-greek $CHORD_DELAY all-released ()
  (i o) @lower-greek   $CHORD_DELAY all-released ()
  (w e) @lower-greek   $CHORD_DELAY all-released ()
  (u i) @unicode-1     $CHORD_DELAY all-released ()
  (e r) @unicode-1     $CHORD_DELAY all-released ()
  (u o) @double-stroke $CHORD_DELAY all-released ()
  (w r) @double-stroke $CHORD_DELAY all-released ()
  (f j) @diacritics    $CHORD_DELAY all-released ()
  ;; }}}
)

;; Typing layers
;; {{{ Aliases
(defalias
  qwe           (layer-switch qwerty)
  cdh           (layer-switch colemak-dh)
)
;; }}}
;; {{{ Qwerty
(deflayer qwerty
  @cdh XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   q    w    e    r    t    y    u    i    o    p    XX   XX   XX
  XX   a    s    d    f    g    h    j    k    l    ;    XX   XX
  lsft z    x    c    v    b    n    m    ,    .    '    XX
  XX   lmet @red           spc            @blue
)
;; }}}
;; {{{ Colemak-DH
(deflayer colemak-dh
  @qwe XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   q    w    f    p    b    j    l    u    y    ;    XX   XX   XX
  XX   a    r    s    t    g    m    n    e    i    o    XX   XX
  XX   z    c    d    v    x    k    h    ,    .    '    XX
  XX   lmet @red           spc            @blue
)
;; }}}

;; Extra layers
;; {{{ Aliases
(defalias
  red    (layer-while-held red)
  blue   (layer-while-held blue)
  purple (layer-while-held purple)
)
;; }}}
;; {{{ Blue (symbol)
(deflayer blue
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    S-=  S-2  S-3  S-4  S-5  S--  S-7  S-8  grv S-grv _    _    _
  _    S-,  S-[  [    S-9  S-/  S-\  -    /    =    S-;  _    _
  _    S-.  S-]  ]    S-0  S-1  @em  S-6  _    _    S-'  _
  _    _    @purple        \              _
)
;; }}}
;; {{{ Red (number & movement)
(deflayer red
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    1    2    3    4    5    home pgdn pgup end  del  _    _    _
  _    6    7    8    9    0    left down up   rght _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _           @purple
)
;; }}}
;; {{{ Purple (fn & action)
(defalias
  ;; Press once to active caps lock for a word (revert after being idle
  ;; for 2s), or twice for real caps lock.
  cps (tap-dance 200 ((caps-word 2000) caps))
  udo (arbitrary-code 131) ;; undo
  cpy (arbitrary-code 133) ;; copy
  pst (arbitrary-code 135) ;; paste
  cut (arbitrary-code 137) ;; cut
)

(deflayer purple
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    f1   f2   f3   f4   f5   @cps @cpy next volu brup _    _    _
  _    f6   f7   f8   f9   f10  @udo @pst pp   vold brdn _    _
  _    f11  f12  _    _    _    _    @cut prev mute _    _
  _    _    _              _              _
)
;; }}}

;; Unicode layers
;; {{{ Aliases
(defalias
  unicode-1     (layer-while-held unicode-1)
  lower-greek   (layer-while-held lowercase-greek)
  upper-greek   (layer-while-held uppercase-greek)
  double-stroke (one-shot-release 1000 (layer-while-held double-stroke))
  diacritics    (one-shot-release 1000 (layer-while-held diacritics))
)
;; }}}
;; {{{ Misc
(defalias
  em (unicode —)
  ⟨ (unicode ⟨)
  ⟩ (unicode ⟩)
  ‹ (unicode ‹)
  › (unicode ›)
  ⋄ (unicode ⋄)
  ∞ (unicode ∞)
  ≔ (unicode ≔)
  ≤ (unicode ≤)
  ≥ (unicode ≥)
  ∈ (unicode ∈)
  ∘ (unicode ∘)
  ¬ (unicode ¬)
  ∃ (unicode ∃)
  ∀ (unicode ∀)
  ⊤ (unicode ⊤)
  ⊥ (unicode ⊥)
  ⊣ (unicode ⊣)
  ⊢ (unicode ⊢)
  ∧ (unicode ∧)
  ∨ (unicode ∨)
)

(deflayer unicode-1
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    @⋄   @∞   _    _    _    _    _    @∘   @≔   _    _    _    _
  _    @≤   @∧   @‹   @⟨   _    @⊢   @⊥   @⊤   @⊣   _    _    _
  _    @≥   @∨   @›   @⟩   @¬   _    _    @∀   @∃   _    _
  _    _    _              _              _
)

;; (deflayer unicode-sets
;;   _    _    _    _    _    _    _    _    _    _    _    _    _    _
;;   _    _    _    _    _    _    _    _    _    _    _    _    _    _
;;   _    @⊆   @⊂   @∈   _    _    _    _    _    _    _    _    _
;;   _    @⊇   @⊃   _    _    _    _    _    _    _    _    _
;;   _    _    _              _              _
;; )
;; }}}
;; {{{ Lowercase greek
(defalias
  φ (unicode φ)
  ω (unicode ω)
  ε (unicode ε)
  ρ (unicode ρ)
  τ (unicode τ)
  ψ (unicode ψ)
  υ (unicode υ)
  ι (unicode ι)
  ο (unicode ο)
  π (unicode π)
  α (unicode α)
  σ (unicode σ)
  δ (unicode δ)
  ς (unicode ς)
  γ (unicode γ)
  η (unicode η)
  θ (unicode θ)
  κ (unicode κ)
  λ (unicode λ)
  ζ (unicode ζ)
  ξ (unicode ξ)
  χ (unicode χ)
  β (unicode β)
  ν (unicode ν)
  μ (unicode μ)
)

(deflayer lowercase-greek
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    @φ   @ω   @ε   @ρ   @τ   @ψ   @υ   @ι   @ο   @π   _    _    _
  _    @α   @σ   @δ   @ς   @γ   @η   @θ   @κ   @λ   _    _    _
  _    @ζ   @ξ   @χ   _    @β   @ν   @μ   _    _    _    _
  _    _    _              _              _
)
;; }}}
;; {{{ Uppercase greek
(defalias
  Φ (unicode Φ)
  Ω (unicode Ω)
  Ε (unicode Ε)
  Ρ (unicode Ρ)
  Τ (unicode Τ)
  Ψ (unicode Ψ)
  Υ (unicode Υ)
  Ι (unicode Ι)
  Ο (unicode Ο)
  Π (unicode Π)
  Α (unicode Α)
  Σ (unicode Σ)
  Δ (unicode Δ)
  Γ (unicode Γ)
  Η (unicode Η)
  Θ (unicode Θ)
  Κ (unicode Κ)
  Λ (unicode Λ)
  Ζ (unicode Ζ)
  Ξ (unicode Ξ)
  Χ (unicode Χ)
  Β (unicode Β)
  Ν (unicode Ν)
  Μ (unicode Μ)
)

(deflayer uppercase-greek
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    @Φ   @Ω   @Ε   @Ρ   @Τ   @Ψ   @Υ   @Ι   @Ο   @Π   _    _    _
  _    @Α   @Σ   @Δ   _    @Γ   @Η   @Θ   @Κ   @Λ   _    _    _
  _    @Ζ   @Ξ   @Χ   _    @Β   @Ν   @Μ   _    _    _    _
  _    _    _              _              _
)
;; }}}
;; {{{ Double stroke
(defalias
  𝔸 (unicode 𝔸)
  𝔹 (unicode 𝔹)
  ℂ (unicode ℂ)
  ⅅ (unicode ⅅ)
  𝔼 (unicode 𝔼)
  𝔽 (unicode 𝔽)
  𝔾 (unicode 𝔾)
  ℍ (unicode ℍ)
  𝕀 (unicode 𝕀)
  𝕁 (unicode 𝕁)
  𝕂 (unicode 𝕂)
  𝕃 (unicode 𝕃)
  𝕄 (unicode 𝕄)
  ℕ (unicode ℕ)
  𝕆 (unicode 𝕆)
  ℙ (unicode ℙ)
  ℚ (unicode ℚ)
  ℝ (unicode ℝ)
  𝕊 (unicode 𝕊)
  𝕋 (unicode 𝕋)
  𝕌 (unicode 𝕌)
  𝕍 (unicode 𝕍)
  𝕎 (unicode 𝕎)
  𝕏 (unicode 𝕏)
  𝕐 (unicode 𝕐)
  ℤ (unicode ℤ)
)

(deflayer double-stroke
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    @ℚ   @𝕎   @𝔼   @ℝ   @𝕋   @𝕐   @𝕌   @𝕀   @𝕆   @ℙ   _    _    _
  _    @𝔸   @𝕊   @ⅅ   @𝔽   @𝔾   @ℍ   @𝕁   @𝕂   @𝕃   _    _    _
  _    @ℤ   @𝕏   @ℂ   @𝕍   @𝔹   @ℕ   @𝕄   _    _    _    _
  _    _    _              _              _
)
;; }}}
;; {{{ Diacritics
(defalias
  ă (unicode ă)
  â (unicode â)
  ș (unicode ș)
  î (unicode î)
  ț (unicode ț)
  Ă (unicode Ă)
  Â (unicode Â)
  Ș (unicode Ș)
  Î (unicode Î)
  Ț (unicode Ț)
)

(deflayer diacritics
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    @Ă   @Â   @Ș   _    _    _    _    @Î   @Ț   _    _    _    _
  _    @ă   @â   @ș   _    _    _    _    @î   @ț   _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _
)
;; }}}
