set $mod Mod4

# Dunst doesn't work otherwise...
exec dbus-update-activation-environment WAYLAND_DISPLAY

output * bg $XDG_CONFIG_HOME/wallpaper fill

exec_always fcitx5
exec_always anyrun daemon # I should make this a systemd service
exec_always xrandr --output XWAYLAND0 --primary

xwayland enable

input type:touchpad {
	dwt enabled
	tap enabled
	natural_scroll enabled
	middle_emulation enabled
}

input type:keyboard {
  xkb_layout "us"
}

default_border pixel 1

# Drag with $mod to move / resize
floating_modifier $mod normal

# Key bindings
bindsym $mod+Return exec foot
bindsym $mod+c kill
bindsym $mod+f fullscreen toggle
bindsym $mod+k focus next
bindsym $mod+j focus prev
bindsym $mod+g layout toggle tabbed splith
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+Shift+x move scratchpad
bindsym $mod+x scratchpad show
bindsym $mod+Shift+r reload

bindsym $mod+q exec wlogout
bindsym $mod+p exec anyrun
bindsym $mod+v exec vimclip
bindsym $mod+s exec wl-ss-area
bindsym $mod+Shift+s exec wl-ss-screen

bindsym --locked XF86AudioMicMute      exec swayosd-client --input-volume  mute-toggle
bindsym --locked XF86AudioMute         exec swayosd-client --output-volume mute-toggle
bindsym --locked XF86AudioLowerVolume  exec swayosd-client --output-volume lower
bindsym --locked XF86AudioRaiseVolume  exec swayosd-client --output-volume raise
bindsym --locked XF86MonBrightnessUp   exec swayosd-client --brightness    raise
bindsym --locked XF86MonBrightnessDown exec swayosd-client --brightness    lower

bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioStop exec playerctl stop

